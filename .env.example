# =============================================================
#         UniPlateTracker Environment Configuration
# =============================================================

# -------------------------------------------------------------
# Core Application Settings
# -------------------------------------------------------------
# Set the primary region for the application.
# Options: "UK" or "INTERNATIONAL"
# - UK: Enables DVLA integration and UK-style license plates.
# - INTERNATIONAL: Disables DVLA features by default and uses a generic plate style.
APP_REGION="UK"

# For INTERNATIONAL mode only. Set to "true" to enable a placeholder
# for your own country's vehicle data API.
# This will show the vehicle details columns in the UI.
ENABLE_INTERNATIONAL_API="false"

# -------------------------------------------------------------
# Database
# -------------------------------------------------------------
POSTGRES_URL="postgresql://postgres:password@localhost:5432/uniplatetracker"
# Optional: Force SSL for Postgres connection.
POSTGRES_SSL="false"
# Set to "false" only when using self-signed certs you trust.
POSTGRES_SSL_REJECT_UNAUTHORIZED="true"

# -------------------------------------------------------------
# Webhook Worker Service
# -------------------------------------------------------------
WORKER_PORT="4000"

# --- UK Specific (only used if APP_REGION is "UK") ---
DVLA_API_KEY="YOUR_DVLA_API_KEY_HERE"

# -------------------------------------------------------------
# Next.js Frontend Application
# -------------------------------------------------------------
# The canonical URL of your Next.js application.
NEXTAUTH_URL="http://YOUR_SERVER_IP:3000"
# Optional (Next.js 16 dev): comma-separated allowed dev origins/hosts.
# Example: NEXT_ALLOWED_DEV_ORIGINS="192.168.1.177,localhost"
NEXT_ALLOWED_DEV_ORIGINS=""

# --- Admin Authentication ---
# A strong, 32-character secret for encrypting session cookies.
SESSION_SECRET="YOUR_SUPER_SECRET_PASSWORD_MUST_BE_AT_LEAST_32_CHARACTERS_LONG"
# Optional: explicitly control whether auth cookies require HTTPS.
# - true: use Secure cookies (recommended for HTTPS deployments)
# - false: allow cookies over HTTP (useful for local/LAN setups)
# Leave unset to auto-detect from NEXTAUTH_URL.
SESSION_COOKIE_SECURE=""

# -------------------------------------------------------------
# Video Capture Configuration (On-Demand) **BUGGY**
# -------------------------------------------------------------
# Set to "true" to enable the video recording feature.
ENABLE_VIDEO_CAPTURE="false"
# The full RTSP or RTSPS URL of your UniFi Protect camera.
RTSP_URL="rtsps://YOUR_CAMERA_IP:7441/YOUR_STREAM_TOKEN"
# The absolute path on the server where final video clips will be saved.
VIDEO_FINAL_CAPTURE_PATH="/opt/captures"
# Temporary path for short video segments. MUST be an absolute path.
VIDEO_BUFFER_PATH="/opt/captures/buffer"
# Duration of each segment in seconds. 30-60s is a good range.
VIDEO_SEGMENT_DURATION=30
# How long to keep buffer segments in minutes before deleting them. 5-10 minutes is sufficient.
VIDEO_BUFFER_RETENTION_MINUTES=5

# -------------------------------------------------------------
# Public Demo Mode
# -------------------------------------------------------------
# Leave this alone for a normal installation. It exists for the public demo
# at uniplatetracker-demo.hgm.gg, which hands out its admin password to
# anyone who visits so the dashboard can actually be looked at.
#
# When "true":
#   - A banner states that the data is synthetic.
#   - The sign-in page prints the demo credentials and hides signup.
#   - Every write route refuses: admin signup, and adding or revoking admins.
#
# Never set this on an installation holding real detections. It does not make
# a deployment safe to expose; it only stops a demo being vandalised.
DEMO_MODE="false"
# Shown on the sign-in page and used by `npm run db:seed-demo`. Only read
# when DEMO_MODE is "true".
DEMO_ADMIN_EMAIL="demo@hgm.gg"
DEMO_ADMIN_PASSWORD="demo1234"
