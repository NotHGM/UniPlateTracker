# ==================================
# UniPlateTracker .gitignore
# ==================================

# --- Dependencies ---
# Ignore the node_modules directory in the root and any subdirectories (like /worker)
node_modules/
.pnp
.pnp.*

# --- Build & Cache Artifacts ---
# Next.js build output and cache
.next/
out/

# TypeScript build info cache
*.tsbuildinfo

# Next.js regenerates this on every dev start and every build, and it points
# at a different path in each mode, so tracking it produces a diff whenever
# anyone switches between the two.
next-env.d.ts

# Our worker's compiled JavaScript output
dist/

# --- Generated Media ---
# Ignore all captured images. This is CRITICAL to prevent bloating the repository.
public/captures/

# --- Logs & Debugging ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Environment Variables (CRITICAL FOR SECURITY) ---
# NEVER commit files with secrets.
# Ignore every environment file, not just the .local variants. A plain .env
# holds exactly the same database credentials and DVLA API key, and was
# previously not covered here at all.
.env
.env.*

# An exception to the rule above: ALWAYS commit an example file.
# This tells other developers what variables are needed for the project.
!/.env.example

# --- IDE & Editor Config ---
# JetBrains IDEs (WebStorm, IntelliJ)
.idea/
# VS Code
.vscode/*
!/.vscode/settings.json
!/.vscode/extensions.json
# Agent instruction files. Next 16 regenerates both of these on every dev
# start and build (see agentRules in next.config), so they are build output
# rather than source.
.claude/
CLAUDE.md
AGENTS.md

# --- OS & Miscellaneous ---
# macOS
.DS_Store
# Private keys
*.pem
# Deployment-specific files (Vercel, etc.)
.vercel/

# Misc
._uniplatetracker
/uniplatetracker

# --- Temporary Video Segments ---
# Ignore the temporary video segments created by the video capture worker
/worker/temp_segments/